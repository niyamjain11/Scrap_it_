# SCRAPIT - Backend Server Configuration
# Copy this file to backend/.env to override default parameters

# Server Host & Port
HOST=0.0.0.0
PORT=8000

# YOLOv8 Weights Path (default: yolov8m.pt)
MODEL_WEIGHTS_PATH=yolov8m.pt

# Object Detection Confidence & Overlap Thresholds
CONFIDENCE_THRESHOLD=0.10
NMS_IOU_THRESHOLD=0.45

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
